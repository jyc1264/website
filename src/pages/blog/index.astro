---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/Card.astro";

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);

const techPosts = (await getCollection("tech")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog" description="Technical blog posts by John Choi.">
  <header class="page-intro blog-intro">
    <p class="eyebrow">Blog</p>
    <h1 class="page-title">Research notes and what's been on my mind.</h1>
  </header>

  <section id="tech" class="blog-catalog" aria-label="Technical articles">
    <ul class="article-list">
      {techPosts.map((post) => (
        <li>
          <Card
            href={`/blog/tech/${post.id}/`}
            eyebrow={post.data.category}
            title={post.data.title}
            description={post.data.description}
            meta={formatDate(post.data.pubDate)}
            datetime={post.data.pubDate.toISOString().slice(0, 10)}
            tags={post.data.tags}
          />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
.blog-intro { max-width: 60rem; padding-bottom: 2rem; }
  .blog-intro h1 { max-width: 20ch; }
  .blog-catalog { padding-bottom: 4rem; scroll-margin-top: 7rem; }
  .article-list { display: grid; gap: .75rem; max-width: 65rem; margin: 0; padding: 0; list-style: none; }
  .article-list > li + li { padding-top: .75rem; border-top: 1px solid var(--line); }
</style>
