---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { tripSlug } from "../utils/trips";
import GalleryLightbox from "@components/GalleryLightbox.astro";
import GalleryImage from "@components/GalleryImage.astro";

type PhotoEntry = CollectionEntry<"photos">;

interface TripGroup {
  title: string;
  displayTitle: string;
  slug: string;
  photos: PhotoEntry[];
}

const knownTripOrder = ["Korea - Early Summer 2026", "France & Italy - Early Summer 2025"];

const photos = await getCollection("photos");
const photosByTrip = new Map<string, PhotoEntry[]>();

for (const photo of photos) {
  const tripPhotos = photosByTrip.get(photo.data.trip) ?? [];
  tripPhotos.push(photo);
  photosByTrip.set(photo.data.trip, tripPhotos);
}

const latestShotDateForTrip = (trip: string) =>
  Math.max(...(photosByTrip.get(trip) ?? []).map((photo) => photo.data.shotDate.valueOf()));

const extraTripTitles = Array.from(photosByTrip.keys())
  .filter((trip) => !knownTripOrder.includes(trip))
  .sort((a, b) => latestShotDateForTrip(b) - latestShotDateForTrip(a));

const formatTripLabel = (value: string) => value.replace(/\s+-\s+Early Summer\s+\d{4}$/i, "");

const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDateRange = (groupPhotos: PhotoEntry[]) => {
  const sortedDates = [...groupPhotos]
    .map((photo) => photo.data.shotDate)
    .sort((a, b) => a.valueOf() - b.valueOf());
  const startDate = sortedDates[0];
  const endDate = sortedDates.at(-1);

  if (!startDate || !endDate) {
    return "";
  }

  const start = dateFormatter.format(startDate);
  const end = dateFormatter.format(endDate);

  return start === end ? start : `${start} - ${end}`;
};

const tripGroups: TripGroup[] = [
  ...knownTripOrder.filter((trip) => photosByTrip.has(trip)),
  ...extraTripTitles,
].map((trip) => ({
  title: trip,
  displayTitle: formatTripLabel(trip),
  slug: tripSlug(trip),
  photos: [...(photosByTrip.get(trip) ?? [])].sort(
    (a, b) => b.data.shotDate.valueOf() - a.data.shotDate.valueOf(),
  ),
}));

const carouselPhotos = tripGroups.flatMap((group) => group.photos);
const photoIndexById = new Map(carouselPhotos.map((photo, index) => [photo.id, index]));
---

<BaseLayout title="Photography" description="Photography portfolio by John Choi.">
  <section class="page-intro gallery-intro" aria-labelledby="gallery-heading">
    <div>
      <p class="eyebrow">Photography</p>
      <h1 id="gallery-heading" class="page-title">Snapshots of my life, aesthetic views, and things I love.</h1>
      <p class="lede">
        Used to shoot on a Sony a6700 with a Sigma 18-50mm f/2.8 lens but now I shoot on a FujiFilm x100vi. Playing around with some Film Recipes.
      </p>
    </div>
    <nav class="trip-nav" aria-label="Photography trips">
      <p class="eyebrow trip-nav-label">The collections</p>
      {tripGroups.map((group) => (
        <a class="nav-region trip-link" href={`#${group.slug}`} aria-labelledby={`trip-link-${group.slug}`}>
          <span>
            <span id={`trip-link-${group.slug}`} class="nav-title trip-link-title">{group.displayTitle}</span>
            <span class="meta trip-link-meta">{group.photos.length} frames · {formatDateRange(group.photos)}</span>
          </span>
          <span class="trip-arrow" aria-hidden="true">↓</span>
        </a>
      ))}
    </nav>
  </section>

  <div class="trip-collections">
    {tripGroups.map((group) => (
      <section id={group.slug} class="trip-collection" aria-labelledby={`${group.slug}-title`}>
        <header class="collection-heading">
          <div>
            <h2 id={`${group.slug}-title`}>{group.displayTitle}</h2>
          </div>
          <p class="meta">{group.photos.length} frames · {formatDateRange(group.photos)}</p>
        </header>
        <div class="photo-grid">
          {group.photos.map((photo) => (
            <GalleryImage photo={photo} index={photoIndexById.get(photo.id) ?? 0} />
          ))}
        </div>
      </section>
    ))}
  </div>
  <GalleryLightbox photos={carouselPhotos} />
</BaseLayout>

<style>
.gallery-intro { display: grid; gap: 2.5rem; align-items: end; }
  .gallery-intro .page-title { max-width: 20ch; }
  .gallery-intro .lede { max-width: 60ch; margin-top: 1.5rem; }
  .trip-nav { min-width: 0; padding: .5rem; border-radius: 1.25rem; background: var(--surface); }
  .trip-nav-label { margin: .5rem 0 .5rem var(--inset-row); }
  .trip-link { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem var(--inset-row); border: 1px solid transparent; border-radius: .875rem; }
  .trip-link > span:first-child { min-width: 0; }
  .trip-link-title { display: block; font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; }
  .trip-link-meta { display: block; margin-top: .375rem; font-size: .8125rem; }
  .trip-arrow { flex: none; color: var(--accent); font-size: 1.125rem; }
  .trip-collections { display: grid; gap: 5rem; padding-bottom: 4rem; }
  .trip-collection { scroll-margin-top: 7rem; min-width: 0; }
  .collection-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .collection-heading h2 { font-family: var(--font-display); font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 650; letter-spacing: -.035em; line-height: 1.1; }
  .collection-heading .meta { font-size: .8125rem; }
  .photo-grid { display: grid; align-items: start; gap: 2rem 1.5rem; }
  @media (min-width: 640px) { .photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .gallery-intro { grid-template-columns: minmax(0, 1fr) 19rem; gap: 5rem; } .photo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media print { .trip-nav { display: none; } .photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
