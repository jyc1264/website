---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import CareerExplorer from "@components/CareerExplorer.astro";
import PhotoStack from "@components/PhotoStack.astro";

const posts = (await getCollection("tech")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const formatDate = (date: Date) => new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" }).format(date);
---

<BaseLayout title="John Choi" description="Machine Learning Engineer and Photographer portfolio.">
  <div class="personal-intro">
    <header class="intro-head">
      <p class="greeting">Hi, I’m</p>
      <h1><span>John</span> <span>Choi.</span></h1>
      <p class="korean-name" lang="ko">최요한</p>
      <p class="intro-role">Machine Learning Infrastructure Engineer & Photographer</p>
    </header>
    <div class="career-area">
      <CareerExplorer />
    </div>
    <div class="intro-bio">
      <p class="original-intro">On my journey, developed real-world communities together at Niantic and scaled semantic relevance at Reddit.</p>
      <p class="location"><svg width="16" height="19" viewBox="0 0 16 19" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M14 7c0 4.5-6 10-6 10S2 11.5 2 7a6 6 0 1 1 12 0Z"/><circle cx="8" cy="7" r="2"/></svg> New York City</p>
    </div>
  </div>

  <section class="focus-note" aria-labelledby="focus-title">
    <h2 id="focus-title">What keeps me curious</h2>
    <p>RAG Pipeline Optimization, Machine Learning Infrastructure, and Visual Storytelling.</p>
  </section>

  <div class="personal-collections">
    <section class="writing-section" aria-labelledby="writing-title">
      <div class="section-heading"><h2 id="writing-title">Thinking out loud.</h2></div>
      <p class="section-description">Research notes and what's been on my mind.</p>
      <ul class="writing-list">
        {posts.map((post) => (
          <li>
            <a class="writing-row nav-region" href={`/blog/tech/${post.id}/`} aria-labelledby={`writing-${post.id}`}>
              <time class="meta" datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDate(post.data.pubDate)}</time>
              <h3 id={`writing-${post.id}`} class="nav-title">{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
      <a class="section-link" href="/blog/">All writing</a>
    </section>
    <section class="personal-photos" aria-labelledby="photography-title">
      <div class="section-heading"><h2 id="photography-title">Away from the keyboard.</h2></div>
      <p class="section-description">Snapshots of my life, aesthetic views, and things I love.</p>
      <PhotoStack />
      <a class="photo-collection-link" href="/gallery/">See the full photo collection</a>
    </section>
  </div>
</BaseLayout>

<style>
  .personal-intro { display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.65fr); grid-template-rows: auto 1fr; gap: 1.75rem clamp(2.5rem, 5vw, 5.5rem); align-items: start; padding-block: 3rem 4.5rem; }
  .intro-head { grid-column: 1; grid-row: 1; }
  .greeting { font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; letter-spacing: -.035em; }
  h1 { margin-top: .875rem; font-family: var(--font-display); font-size: clamp(4.25rem, 8.1vw, 7.5rem); font-weight: 750; line-height: .87; letter-spacing: -.045em; }
  h1 span { display: block; }
  .korean-name { display: inline-block; margin-top: 1.75rem; padding: .35rem .875rem .45rem; border: 1px solid var(--text); border-radius: 45% 50% 42% 48%; background: var(--chapter-pink); color: var(--text); font-size: 1.125rem; font-weight: 500; transform: rotate(-5deg); }
  .intro-role { max-width: 26ch; margin-top: 1.25rem; font-size: 1rem; font-weight: 600; line-height: 1.65; }
  .career-area { grid-column: 2; grid-row: 1 / -1; min-width: 0; padding-top: .25rem; }
  .intro-bio { grid-column: 1; grid-row: 2; color: var(--text-2); }
  .original-intro { max-width: 34ch; font-size: .9375rem; line-height: 1.85; }
  .location { display: flex; align-items: center; gap: .5rem; margin-top: 1rem; color: var(--muted); font-size: .8125rem; }
  .focus-note { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; padding: 1.5rem 0; border-block: 1px solid var(--line-strong); }
  .focus-note h2 { flex: 0 0 17rem; font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; letter-spacing: -.035em; }
  .focus-note p { max-width: 62ch; color: var(--text-2); font-size: .9375rem; line-height: 1.75; }
  .personal-collections { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(3rem, 7vw, 7rem); padding-block: 4rem 1rem; }
  .personal-collections > section { min-width: 0; }
  .personal-collections .section-heading { margin-bottom: .75rem; }
  .section-description { max-width: 44ch; color: var(--muted); font-size: .9375rem; line-height: 1.75; }
  .writing-list { display: grid; gap: .25rem; margin: 1.25rem -1rem 1rem; padding: 0; list-style: none; }
  .writing-row { display: block; padding: 1.25rem var(--inset-row); border: 1px solid transparent; }
  .writing-row h3 { max-width: 28ch; margin-top: .5rem; font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; letter-spacing: -.04em; line-height: 1.18; }
  .writing-row > p { margin-top: .75rem; color: var(--text-2); font-size: .875rem; line-height: 1.75; }
  .photo-collection-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 1rem; padding: .5rem .75rem; color: var(--text); font-size: .875rem; text-decoration: underline; }
  @media (max-width: 1050px) {
    .personal-intro { grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: 1.5rem 2rem; }
    h1 { font-size: 6rem; }
    .personal-collections { gap: 3rem; }
  }
  @media (max-width: 760px) {
    .personal-intro { display: flex; flex-direction: column; gap: 2rem; padding-block: 2rem 3rem; }
    .intro-head { width: 100%; }
    .greeting { font-size: 1.125rem; }
    h1 { display: flex; flex-wrap: wrap; gap: 0 .2em; margin-top: .75rem; font-size: clamp(3.75rem, 11vw, 5.5rem); line-height: .98; }
    .korean-name { float: right; margin-top: -3rem; font-size: .9375rem; }
    .intro-role { max-width: 35ch; margin-top: 1rem; font-size: .9375rem; }
    .career-area { width: 100%; }
    .intro-bio { width: 100%; }
    .original-intro { max-width: 60ch; }
    .focus-note { flex-direction: column; gap: .75rem; }
    .focus-note h2 { flex-basis: auto; }
    .personal-collections { grid-template-columns: 1fr; gap: 3.5rem; padding-top: 3rem; }
    .personal-photos { max-width: 34rem; }
  }
  @media (max-width: 380px) { .korean-name { float: none; margin-top: .875rem; } h1 { font-size: 3.6rem; } }
  @media print { .personal-intro, .personal-collections { display: block; } .intro-head, .career-area, .intro-bio, .personal-collections section { margin-bottom: 2rem; } .photo-collection-link { display: none; } .korean-name { transform: none; } }
</style>
