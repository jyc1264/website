---
export interface Props {
  title: string;
  description: string;
  href?: string;
  eyebrow?: string;
  meta?: string;
  datetime?: string;
  tags?: string[];
  headingLevel?: 2 | 3;
  id?: string;
}

const {
  title,
  description,
  href,
  eyebrow,
  meta,
  datetime,
  tags = [],
  headingLevel = 2,
  id,
} = Astro.props;
const Element = href ? "a" : "article";
const Heading = headingLevel === 3 ? "h3" : "h2";
const titleId = id ?? `article-${(href ?? title).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`;
---

<Element href={href} class:list={["article-card", href && "nav-region"]} aria-labelledby={titleId}>
  <div class="article-card-copy">
    {(eyebrow || meta) && (
      <div class="article-card-meta meta">
        {eyebrow && <span>{eyebrow}</span>}
        {meta && <time datetime={datetime}>{meta}</time>}
      </div>
    )}
    <Heading id={titleId} class:list={["article-card-title", href && "nav-title"]}>{title}</Heading>
    <p class="article-card-description">{description}</p>
    {tags.length > 0 && (
      <ul class="article-card-tags" aria-label="Topics">
        {tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    )}
  </div>
  {href && <span class="article-card-arrow" aria-hidden="true">Read</span>}
</Element>

<style>
.article-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--inset-row);
    padding: 1.75rem var(--inset-panel);
    border: 1px solid transparent;
    border-radius: 1.25rem;
    color: var(--text);
    text-decoration: none;
  }
  .article-card-copy { min-width: 0; }
  .article-card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; margin-bottom: .875rem; }
  .article-card-meta span { padding: .2rem .625rem; border-radius: 999px; background: var(--chapter-yellow); color: var(--text); font-size: .75rem; }
  .article-card-title { max-width: 30ch; margin: 0; font-family: var(--font-display); font-size: clamp(1.75rem, 2.8vw, 2.5rem); font-weight: 650; letter-spacing: -.035em; line-height: 1.12; text-wrap: pretty; }
  .article-card-description { max-width: 64ch; margin: 1rem 0 0; color: var(--text-2); font-size: 1rem; line-height: 1.75; }
  .article-card-tags { display: flex; flex-wrap: wrap; gap: .375rem .625rem; margin: 1.125rem 0 0; padding: 0; list-style: none; }
  .article-card-arrow { margin-top: .15rem; padding-bottom: .1rem; border-bottom: 1px solid currentColor; color: var(--accent); font-size: .8125rem; font-weight: 600; line-height: 1.4; }
  @media (max-width: 600px) { .article-card { grid-template-columns: minmax(0, 1fr); gap: 1rem; padding: 1.5rem var(--inset-row); } .article-card-arrow { justify-self: start; } }
</style>
