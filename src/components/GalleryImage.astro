---
import { Image, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getPhotoAsset } from "../utils/photoAssets";

export interface Props {
  photo: CollectionEntry<"photos">;
  index: number;
}

const { photo, index } = Astro.props;
const image = getPhotoAsset(photo.data.imageSrc);
const fullImage = await getImage({ src: image, width: 1920, format: "webp", quality: "mid" });
const titleId = `photo-title-${photo.id}`;
---

<a class="photo-link nav-region" href={fullImage.src} data-gallery-open={index} data-astro-reload aria-labelledby={titleId}>
  <figure class="photo-figure">
    <div class="photo-image">
      <Image
        src={image}
        alt={photo.data.title}
        width={960}
        widths={[320, 480, 640, 800, 960]}
        sizes="(min-width: 1000px) 24rem, (min-width: 640px) calc((100vw - 5rem) / 2), calc(100vw - 2.5rem)"
        format="webp"
        quality="mid"
        loading={index < 3 ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : "auto"}
        decoding="async"
      />
      <span class="image-open" aria-hidden="true">View photo</span>
    </div>
    <figcaption class="photo-caption">
      <h3 id={titleId} class="nav-title">{photo.data.title}</h3>
      <p class="photo-description">{photo.data.description}</p>
      <p class="meta photo-settings">{photo.data.cameraSettings}</p>
    </figcaption>
  </figure>
</a>

<style>
.photo-link { display: block; min-width: 0; border: 1px solid var(--line); background: var(--surface); padding: .625rem; border-radius: .375rem; box-shadow: 0 3px 0 var(--line); }
  .photo-figure { margin: 0; }
  .photo-image { position: relative; overflow: hidden; background: var(--surface-2); }
  .photo-image img { display: block; width: 100%; height: auto; }
  .image-open { display: grid; place-items: center; position: absolute; right: .75rem; bottom: .75rem; min-height: 2rem; padding: .35rem .75rem; border: 1px solid rgb(255 255 255 / .6); border-radius: 999px; background: rgb(45 32 61 / .86); color: #fff; font-family: var(--font-sans); font-size: .6875rem; line-height: 1.4; }
  .photo-caption { padding: 1rem .5rem .75rem; }
  .photo-caption h3 { margin: 0; color: var(--text); font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; letter-spacing: -.025em; line-height: 1.25; }
  .photo-description { margin-top: .5rem; color: var(--text-2); font-size: .875rem; line-height: 1.6; overflow-wrap: anywhere; }
  .photo-settings { margin-top: .875rem; color: var(--muted); font-size: .75rem; line-height: 1.6; }
  @media print { .photo-link { break-inside: avoid; box-shadow: none; } .image-open { display: none; } }
</style>
