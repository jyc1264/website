---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getPhotoAsset } from "../utils/photoAssets";

export interface Props {
  photos: CollectionEntry<"photos">[];
}

const { photos } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("en", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const carouselPhotos = photos.map((photo) => ({
  title: photo.data.title,
  description: photo.data.description,
  metadata: photo.data.cameraSettings,
  date: dateFormatter.format(photo.data.shotDate),
  trip: photo.data.trip,
}));
---

<gallery-viewer>
  <dialog id="gallery-lightbox" class="gallery-lightbox" aria-labelledby="gallery-lightbox-title">
    <div class="lightbox-shell">
      <header class="lightbox-header">
        <p class="meta" id="gallery-lightbox-count" role="status" aria-live="polite" aria-atomic="true">01 / {String(photos.length).padStart(2, "0")}</p>
        <button type="button" data-gallery-close class="icon-button lightbox-close" aria-label="Close photograph" autofocus>×</button>
      </header>
      <div class="lightbox-content">
        <div class="lightbox-stage">
          {photos.map((photo) => (
            <Image
              src={getPhotoAsset(photo.data.imageSrc)}
              alt={photo.data.title}
              width={1920}
              widths={[960, 1440, 1920]}
              sizes="(min-width: 1000px) calc(100vw - 22rem), 100vw"
              format="webp"
              quality="mid"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              data-gallery-lightbox-image
              hidden
            />
          ))}
        </div>
        <aside class="lightbox-caption">
          <p class="eyebrow" id="gallery-lightbox-trip"></p>
          <h2 id="gallery-lightbox-title">Photograph</h2>
          <p id="gallery-lightbox-description"></p>
          <div class="lightbox-metadata meta">
            <p id="gallery-lightbox-date"></p>
            <p id="gallery-lightbox-metadata"></p>
          </div>
        </aside>
      </div>
      <footer class="lightbox-footer">
        <button type="button" data-gallery-prev class="lightbox-step" aria-label="View previous photograph"><span aria-hidden="true">←</span> Previous</button>
        <span class="lightbox-hint meta">Arrow keys to browse · Esc to close</span>
        <button type="button" data-gallery-next class="lightbox-step" aria-label="View next photograph">Next <span aria-hidden="true">→</span></button>
      </footer>
    </div>
  </dialog>
  <script is:inline type="application/json" data-gallery-data set:html={JSON.stringify(carouselPhotos).replace(/</g, "\\u003c")} />
</gallery-viewer>

<script>
  interface CarouselPhoto {
    title: string;
    description: string;
    metadata: string;
    date: string;
    trip: string;
  }

  // A custom element reconnects for each Astro navigation and releases old listeners.
  class GalleryViewer extends HTMLElement {
    private controller?: AbortController;
    private previousOverflow = "";
    private opener?: HTMLAnchorElement;

    connectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>("dialog");
      const data = this.querySelector("[data-gallery-data]");
      if (!dialog || !data) return;
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const photos = JSON.parse(data.textContent ?? "[]") as CarouselPhoto[];
      const images = Array.from(dialog.querySelectorAll<HTMLImageElement>("[data-gallery-lightbox-image]"));
      let activeIndex = 0;
      const setText = (id: string, value: string) => {
        const element = dialog.querySelector(`#${id}`);
        if (element) element.textContent = value;
      };
      const renderPhoto = (index: number) => {
        const photo = photos[index];
        if (!photo) return;
        activeIndex = index;
        images.forEach((image, imageIndex) => {
          image.hidden = imageIndex !== index;
          image.loading = imageIndex === index ? "eager" : "lazy";
          image.setAttribute("fetchpriority", imageIndex === index ? "high" : "low");
        });
        setText("gallery-lightbox-title", photo.title);
        setText("gallery-lightbox-description", photo.description);
        setText("gallery-lightbox-metadata", photo.metadata);
        setText("gallery-lightbox-date", photo.date);
        setText("gallery-lightbox-trip", photo.trip);
        setText("gallery-lightbox-count", `${String(index + 1).padStart(2, "0")} / ${String(photos.length).padStart(2, "0")}`);
      };
      const moveBy = (offset: number) => {
        if (photos.length) renderPhoto((activeIndex + offset + photos.length) % photos.length);
      };
      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[data-gallery-open]") : null;
        if (!link || !photos.length || typeof dialog.showModal !== "function") return;
        const index = Number(link.dataset.galleryOpen);
        if (!Number.isInteger(index) || !photos[index]) return;
        event.preventDefault();
        this.opener = link;
        renderPhoto(index);
        if (!dialog.open) {
          this.previousOverflow = document.documentElement.style.overflow;
          document.documentElement.style.overflow = "hidden";
          dialog.showModal();
        }
      }, { signal });
      const restoreScrolling = () => {
        document.documentElement.style.overflow = this.previousOverflow;
      };
      dialog.querySelector("[data-gallery-close]")?.addEventListener("click", () => {
        restoreScrolling();
        dialog.close();
      }, { signal });
      // Escape's native focus restoration precedes the queued close event.
      dialog.addEventListener("cancel", restoreScrolling, { signal });
      dialog.querySelector("[data-gallery-prev]")?.addEventListener("click", () => moveBy(-1), { signal });
      dialog.querySelector("[data-gallery-next]")?.addEventListener("click", () => moveBy(1), { signal });
      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          event.preventDefault();
          moveBy(event.key === "ArrowLeft" ? -1 : 1);
        }
      }, { signal });
      dialog.addEventListener("close", () => {
        restoreScrolling();
        if (this.opener?.isConnected) this.opener.focus({ preventScroll: true });
      }, { signal });
    }

    disconnectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>("dialog");
      if (dialog?.open) {
        document.documentElement.style.overflow = this.previousOverflow;
        dialog.close();
      }
      this.controller?.abort();
    }
  }

  if (!customElements.get("gallery-viewer")) customElements.define("gallery-viewer", GalleryViewer);
</script>

<style>
  gallery-viewer { display: contents; }
  .gallery-lightbox { position: fixed; inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; overflow: hidden; border: 0; background: var(--bg); color: var(--text); }
  .gallery-lightbox::backdrop { background: rgb(45 32 61 / .9); }
  .lightbox-shell { display: grid; height: 100%; grid-template-rows: auto minmax(0, 1fr) auto; }
  .lightbox-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; border-bottom: 1px solid var(--line); }
  .lightbox-header .meta { font-size: .75rem; }
  .lightbox-close { width: 2.75rem; height: 2.75rem; font-size: 1.5rem; }
  .lightbox-content { display: grid; min-height: 0; grid-template-rows: minmax(8rem, 1fr) auto; overflow: auto; }
  .lightbox-stage { display: flex; min-height: 0; align-items: center; justify-content: center; padding: 1rem; overflow: hidden; background: var(--surface); }
  .lightbox-stage img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .lightbox-stage img[hidden] { display: none; }
  .lightbox-caption { padding: 1.25rem; border-top: 1px solid var(--line); overflow: auto; }
  .lightbox-caption .eyebrow { font-size: .8125rem; }
  .lightbox-caption h2 { margin-top: .75rem; font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 650; letter-spacing: -.035em; line-height: 1.2; }
  #gallery-lightbox-description { margin-top: .75rem; color: var(--text-2); font-size: .9375rem; line-height: 1.6; }
  .lightbox-metadata { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1rem; color: var(--muted); font-size: .75rem; line-height: 1.7; }
  .lightbox-footer { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .75rem 1rem; border-top: 1px solid var(--line); }
  .lightbox-step { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .75rem; padding: .5rem .75rem; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); color: var(--text); font-family: var(--font-sans); font-size: .875rem; cursor: pointer; }
  .lightbox-step:hover { background: var(--hover); }
  .lightbox-hint { display: none; font-size: .6875rem; text-align: center; }
  @media (min-width: 640px) { .lightbox-header, .lightbox-footer { padding-inline: 1.5rem; } .lightbox-hint { display: block; } }
  @media (min-width: 1000px) { .lightbox-content { grid-template-columns: minmax(0, 1fr) 20rem; grid-template-rows: minmax(0, 1fr); overflow: hidden; } .lightbox-stage { padding: 2rem; } .lightbox-caption { padding: 2rem; border-top: 0; border-left: 1px solid var(--line); } .lightbox-metadata { display: grid; margin-top: 2rem; } }
  @media print { gallery-viewer { display: none; } }
</style>
